# ===========================================
# LEARNIFY LMS - SENSITIVE CONFIGURATION
# ===========================================
# This file contains ONLY sensitive data that should not be version controlled.
# Non-sensitive configuration is stored in cfg/ YAML files.

# Environment (determines which YAML config to load)
ENVIRONMENT=development

# Database Credentials (SENSITIVE)
DB_HOST=localhost
DB_USER=learnify
DB_PASSWORD=password
# Note: DB_PORT, DB_NAME, DB_DRIVER are in cfg/base.yaml

# Redis Credentials (SENSITIVE)
REDIS_HOST=localhost
# REDIS_PASSWORD=your-redis-password-if-needed
# Note: REDIS_PORT, REDIS_DB are in cfg/base.yaml

# JWT Secrets (SENSITIVE)
SECRET_KEY=your-super-secret-key-here-change-in-production

# Email API Keys (SENSITIVE)
SENDGRID_API_KEY=your-sendgrid-api-key-here
FROM_EMAIL=noreply@learnify.com

# Security Secrets (SENSITIVE)
CSRF_SECRET_KEY=your-csrf-secret-key-here

# External Service API Keys (SENSITIVE)
# Add any other API keys here when needed

# Legacy Support: Direct URLs (Override individual components)
# DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/learnify_db
# REDIS_URL=redis://localhost:6379/0

# ===========================================
# NOTES:
# - Non-sensitive configs are in cfg/base.yaml and cfg/development.yaml
# - Port numbers, timeouts, limits are in YAML files
# - Only secrets, passwords, API keys belong here
# - Copy this to .env and fill in actual values
