# ===========================================
# LEARNIFY LMS - PRODUCTION SENSITIVE CONFIG
# ===========================================
# This file contains ONLY sensitive data for production.
# Non-sensitive configuration is stored in cfg/ YAML files.

# Environment (determines which YAML config to load)
ENVIRONMENT=production

# Database Credentials (SENSITIVE - CHANGE IN PRODUCTION!)
DB_HOST=db-host
DB_USER=learnify
DB_PASSWORD=your-secure-db-password

# Redis Credentials (SENSITIVE)
REDIS_HOST=redis-host
REDIS_PASSWORD=your-redis-password-for-production

# JWT Secrets (SENSITIVE - CHANGE THESE IN PRODUCTION!)
SECRET_KEY=your-super-secret-jwt-key-at-least-32-characters-long

# Email API Keys (SENSITIVE)
SENDGRID_API_KEY=your-sendgrid-api-key
FROM_EMAIL=noreply@yourdomain.com

# Security Secrets (SENSITIVE)
CSRF_SECRET_KEY=your-csrf-secret-key-production

# Legacy Support: Direct URLs (Override individual components)
# DATABASE_URL=postgresql+asyncpg://username:password@db-host:5432/database_name
# REDIS_URL=redis://redis-host:6379/0

# Legacy PostgreSQL Environment Variables (for Docker compatibility)
POSTGRES_DB=learnify_db
POSTGRES_USER=learnify
POSTGRES_PASSWORD=your-secure-db-password

# External Service API Keys (SENSITIVE)
# SENTRY_DSN=your-sentry-dsn-for-error-tracking

# SSL/TLS Configuration (SENSITIVE)
# SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
# SSL_KEY_PATH=/etc/nginx/ssl/private.key

# ===========================================
# NOTES:
# - Non-sensitive configs are in cfg/base.yaml and cfg/production.yaml
# - Port numbers, timeouts, CORS origins are in YAML files
# - Only secrets, passwords, API keys belong here
# - CHANGE ALL DEFAULT VALUES IN PRODUCTION!
# ========================================== 